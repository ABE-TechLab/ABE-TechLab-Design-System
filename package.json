{
  "name": "@godtech-ctl-create/abe-techlab-design-system",
  "version": "0.1.0",
  "description": "Shared CSS design tokens and theme palettes for ABE TechLab products.",
  "license": "MIT",
  "type": "module",
  "files": [
    "styles",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./styles/index.css",
    "./styles/*": "./styles/*",
    "./themes.json": "./styles/themes.json"
  },
  "scripts": {
    "check": "node scripts/check-themes.mjs",
    "prepack": "npm run check"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "abe-techlab",
    "design-system",
    "tailwindcss",
    "themes",
    "design-tokens"
  ]
}
